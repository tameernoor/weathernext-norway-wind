# Fully qualified WeatherNext 3 table, as linked into your project via Analytics Hub.
WEATHERNEXT_TABLE=your-project.your_dataset.weathernext_3_0_0_0p1deg

# Most a single wnw query may bill, in GB. A query over it fails without being
# charged. BigQuery checks this against its estimate, which for the box queries
# runs far above what they read, so it can't be much lower. Dry runs are not
# affected; dbt has no such cap.
WNW_MAX_GB=1000

# Project that is billed for the query.
GOOGLE_CLOUD_PROJECT=your-project

# dbt route only: the dataset dbt builds into, and its location. The location
# must match the WeatherNext dataset you subscribed to.
DBT_DATASET=weathernext_norway_wind
DBT_LOCATION=US
